# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# Socket.IO Configuration
PING_TIMEOUT=60000
PING_INTERVAL=25000

# Game Configuration
MAX_PLAYERS_PER_ROOM=2
MIN_PLAYERS_TO_START=2
INACTIVITY_TIMEOUT=1800000
ROOM_CLEANUP_INTERVAL=300000
MIN_POINTS_TO_GO_DOWN=50

# Redis Configuration
# Required when NODE_ENV=production.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ADAPTER_ENABLED=false

# Logging Configuration
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIR=./logs

# Per-game logs (dev console → Logs tab, GET /dev/api/rooms/<roomId>/logs).
# Every line attributable to a room is kept per room for GAME_LOG_RETENTION_MS
# after its last line (default 2h), finished games included. See docs/GAME_LOGS.md.
GAME_LOG_ENABLED=true
GAME_LOG_LEVEL=debug
GAME_LOG_RETENTION_MS=7200000
GAME_LOG_MAX_ENTRIES_PER_ROOM=4000
GAME_LOG_MAX_TOTAL_ENTRIES=400000
# JSONL file per room so logs survive a restart (defaults to LOG_FILE when unset).
GAME_LOG_FILE=false
GAME_LOG_DIR=./logs/games

# Restart resilience (deploy without ending live games; docs/RESTART_RESILIENCE.md).
# After a restart every restored room is held — no turn timer / bot / next-round
# deal — until one of its players rejoins or RESTART_HOLD_MS elapses.
RESTART_HOLD_MS=60000
# The resumed turn keeps the time it had left at shutdown, but never less than this.
RESTART_MIN_TURN_MS=10000
# Upper bound on the final all-rooms snapshot written at shutdown.
RESTART_SNAPSHOT_TIMEOUT_MS=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
WEBHOOK_SECRET=0e2fc0a3f9c334dcb2e490cf5ccd42bdfd2234da339aea858b952e0904fca2f4
BACKEND_URL=https://dev.app.wliveapp.com
# 8080 is taken by wlive-nginx on this host.
LB_PORT=8090
